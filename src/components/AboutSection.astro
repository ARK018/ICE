---

<div
  class="w-full max-w-[1080px] mx-auto mt-16 md:mt-24 lg:mt-32 px-4 md:px-6 lg:px-8"
>
  <div class="flex flex-col justify-center md:items-center md:justify-center gap-3">
    <div class="flex flex-col justify-center md:items-center md:justify-center">
      <h1
        class="fade text-3xl md:text-4xl text-[#131820] font-semibold leading-[110%] tracking-[-0.02em]"
      >
        About Intercontinental Exim
      </h1>
      <p class="fade text-ocean/50 text-sm md:text-base">
        A venture of Elegance Express
      </p>
    </div>
    <p
      class="fade text-[#131820] opacity-[50%] max-w-2xl text-sm md:text-base"
    >
      At Intercontinental Exim, we believe in bridging the gap between
      continents through world-class trade services. Our mission is to provide
      premium products that uphold the highest standards of quality,
      reliability, and sustainability.
    </p>
    <a
      href="/about"
      class="fade mt-3 md:mt-5 px-5 md:px-7 py-1.5 md:py-2 rounded-full border-2 border-[#131820] text-black cursor-pointer w-fit text-sm md:text-base hover:bg-[#131820] hover:text-white transition-colors text-left"
    >
      About
    </a>
    <div class="pt-16 md:pt-20 lg:pt-24 w-full">
      <div
        class="w-full mx-auto grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6 md:gap-8"
      >
        <div
          class="slide w-full flex flex-col justify-between text-left border-l border-gray-300 pl-4 py-4 md:py-6"
        >
          <div class="pb-12 md:pb-24">
            <h3 class="text-sky text-lg md:text-xl font-bold mb-2 text-left">
              01
            </h3>
            <h4
              class="text-lg md:text-xl leading-tight font-bold text-gray-900 mb-2 text-left"
            >
              Across Continents
            </h4>
          </div>
          <p class="text-gray-600 text-left text-sm md:text-base">
            Operating globally ensuring timely and seamless delivery.
          </p>
        </div>
        <div
          class="slide w-full flex flex-col justify-between text-left border-l border-gray-300 pl-4 py-4 md:py-6"
        >
          <div class="pb-12 md:pb-24">
            <h3 class="text-sky text-lg md:text-xl font-bold mb-2 text-left">
              02
            </h3>
            <h4
              class="text-lg md:text-xl leading-tight font-bold text-gray-900 mb-2 text-left"
            >
              Quality Assurance
            </h4>
          </div>
          <p class="text-gray-600 text-left text-sm md:text-base">
            Strict quality control guarantees top IT and food products.
          </p>
        </div>
        <div
          class="slide w-full flex flex-col justify-between text-left border-l border-gray-300 pl-4 py-4 md:py-6"
        >
          <div class="pb-12 md:pb-24">
            <h3 class="text-sky text-lg md:text-xl font-bold mb-2 text-left">
              03
            </h3>
            <h4
              class="text-lg md:text-xl leading-tight font-bold text-gray-900 mb-2 text-left"
            >
              Diverse Product Range
            </h4>
          </div>
          <p class="text-gray-600 text-left text-sm md:text-base">
            One-stop shop for IT services, design, and various products.
          </p>
        </div>
        <div
          class="slide w-full flex flex-col justify-between text-left border-l border-gray-300 pl-4 py-4 md:py-6"
        >
          <div class="pb-12 md:pb-24">
            <h3 class="text-sky text-lg md:text-xl font-bold mb-2 text-left">
              04
            </h3>
            <h4
              class="text-lg md:text-xl leading-tight font-bold text-gray-900 mb-2 text-left"
            >
              Customer <br /> Centric
            </h4>
          </div>
          <p class="text-gray-600 text-left text-sm md:text-base">
            Personalized services to build strong and lasting relationships.
          </p>
        </div>
        <div
          class="slide w-full flex flex-col justify-between text-left border-l border-gray-300 pl-4 py-4 md:py-6"
        >
          <div class="pb-12 md:pb-24">
            <h3 class="text-sky text-lg md:text-xl font-bold mb-2 text-left">
              05
            </h3>
            <h4
              class="text-lg md:text-xl leading-tight font-bold text-gray-900 mb-2 text-left"
            >
              Sustainable Practices
            </h4>
          </div>
          <p class="text-gray-600 text-left text-sm md:text-base">
            Eco-friendly sourcing and ethical supply chain focus.
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);
  const elements = document.querySelectorAll(".fade");
  gsap.from(elements, {
    opacity: 0,
    y: 20,
    stagger: {
      each: 0.2,
    },
    scrollTrigger: {
      trigger: elements,
      toggleActions: "play pause resume reset",
      start: "top 80%",
    },
  });

  const card = document.querySelectorAll(".slide");
  gsap.from(card, {
    opacity: 0,
    x: -20,
    stagger: {
      each: 0.2,
    },
    scrollTrigger: {
      trigger: card,
      toggleActions: "play none none reset",
      start: "top 80%",
      once: false,
    },
  });
</script>
