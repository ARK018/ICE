---
import CTA_globe from "../assets/CTA-globe.jpg";
import { Image } from "astro:assets";
---

<!-- Get In Touch -->
<div
  class="relative flex flex-col items-center w-full text-center bg-[#0a2540] gap-3 md:gap-4 px-4 sm:px-8 md:px-12 lg:px-20 py-16 md:py-24 lg:py-32"
>
  <Image
    class="absolute inset-0 w-full h-full object-cover object-bottom"
    src={CTA_globe}
    alt="cta-globe"
    loading="eager"
  />

  <div class="absolute inset-0 w-full h-full bg-black/60"></div>

  <div
    class="fades z-10 flex flex-col items-center gap-3 md:gap-4 max-w-[90%] md:max-w-[80%] lg:max-w-[1080px]"
  >
    <h1
      class="text-2xl md:text-3xl text-pretty font-bold text-white leading-tight"
    >
      Join us in creating a global impact.
    </h1>
    <p
      class="fades text-base md:text-lg text-white/60 max-w-[42ch] md:max-w-[64ch]"
    >
      Our dedicated team works tirelessly to ensure a seamless experience,
      making us a preferred partner in international trade.
    </p>
    <a
      href="/contact"
      class="fades w-fit mt-2 md:mt-3 px-5 md:px-7 py-1.5 md:py-2 rounded-full bg-sky hover:bg-ocean text-white cursor-pointer text-sm md:text-base transition-colors"
    >
      Get In Touch
    </a>
  </div>
</div>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);
  const elements = document.querySelectorAll(".fades");
  gsap.from(elements, {
    opacity: 0,
    y: 20,
    stagger: {
      each: 0.2,
    },
    scrollTrigger: {
      trigger: elements,
      toggleActions: "play pause resume reset",
      start: "top 80%",
    },
  });
</script>
