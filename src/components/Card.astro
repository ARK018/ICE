---
import { Image } from "astro:assets";
import { services } from "../data/services";
---

<>
  {
    services.map((service) => (
      <a
        href={`/services/${service.slug}`}
        class="block w-full hover:scale-[1.02] transition-transform duration-300"
      >
        <div class="w-full bg-white rounded-[18px] shadow-card-shadow overflow-hidden p-3 border">
          <div class="bg-gray-100 p-6 relative h-60">
            <Image
              src={service.heroImage}
              alt={service.title}
              class="object-cover absolute top-0 left-0 w-full h-full rounded-lg"
              loading="eager"
            />
          </div>
          <div class="p-6">
            <h2 class="text-xl font-semibold mb-2">{service.title}</h2>
            <p class="text-gray-600">{service.cardDescription}</p>
          </div>
        </div>
      </a>
    ))
  }
</>
