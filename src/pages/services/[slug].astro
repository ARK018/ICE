---
import Layout from "../../layouts/Layout.astro";
import CTA from "../../components/CTA.astro";
import { Image } from "astro:assets";
import { services } from "../../data/services";

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
---

<Layout title={service.title}>
  <main class="min-h-screen bg-white">
    <!-- Hero Section -->
    <div class="relative w-full h-[50vh] md:h-[60vh] overflow-hidden">
      <Image
        src={service.heroImage}
        alt={service.title}
        class="absolute inset-0 w-full h-full object-cover"
        loading="eager"
      />
      <div class="absolute inset-0 bg-black/55"></div>
      <div
        class="service_fade relative z-10 flex flex-col items-center justify-center h-full text-center px-4 sm:px-8"
      >
        <h1
          class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-3 md:mb-4"
        >
          {service.title}
        </h1>
        <p class="text-base md:text-lg text-white/70 max-w-2xl">
          {service.tagline}
        </p>
      </div>
    </div>

    <!-- Description Section -->
    <div
      class="service_fade max-w-[1080px] mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16 lg:py-20"
    >
      <h2
        class="text-xl md:text-2xl lg:text-3xl font-semibold text-gray-800 mb-4 md:mb-6"
      >
        About {service.title}
      </h2>
      <p class="text-base md:text-lg text-gray-600 leading-relaxed">
        {service.description}
      </p>
    </div>

    <!-- Gallery Section -->
    <div
      class="max-w-[1080px] mx-auto px-4 sm:px-6 lg:px-8 pb-12 md:pb-16 lg:pb-20"
    >
      <h2
        class="service_fade text-xl md:text-2xl lg:text-3xl font-semibold text-gray-800 mb-6 md:mb-8"
      >
        What We Offer
      </h2>

      {service.gallerySections ? (
        <div class="flex flex-col gap-10 md:gap-14">
          {service.gallerySections.map((section: { heading: string; items: { image: ImageMetadata; name: string }[] }) => (
            <div>
              <h3 class="service_fade text-lg md:text-xl font-semibold text-gray-700 mb-4 md:mb-6">
                {section.heading}
              </h3>
              <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
                {section.items.map((item: { image: ImageMetadata; name: string }) => (
                  <div class="gallery_card">
                    <div class="relative aspect-square rounded-2xl overflow-hidden">
                      <Image
                        src={item.image}
                        alt={item.name}
                        class="object-cover absolute inset-0 w-full h-full"
                        loading="lazy"
                      />
                    </div>
                    <h4 class="mt-3 text-base md:text-lg font-medium text-gray-800">
                      {item.name}
                    </h4>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      ) : (
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
          {service.gallery?.map((item: { image: ImageMetadata; name: string }) => (
            <div class="gallery_card">
              <div class="relative aspect-square rounded-2xl overflow-hidden">
                <Image
                  src={item.image}
                  alt={item.name}
                  class="object-cover absolute inset-0 w-full h-full"
                  loading="lazy"
                />
              </div>
              <h3 class="mt-3 text-base md:text-lg font-medium text-gray-800">
                {item.name}
              </h3>
            </div>
          ))}
        </div>
      )}
    </div>

    <CTA />
  </main>
</Layout>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const fades = document.querySelectorAll(".service_fade");
  gsap.from(fades, {
    opacity: 0,
    y: 20,
    stagger: {
      each: 0.2,
    },
    scrollTrigger: {
      trigger: fades,
      toggleActions: "play pause resume reset",
      start: "top 80%",
    },
  });

  const cards = document.querySelectorAll(".gallery_card");
  gsap.from(cards, {
    opacity: 0,
    y: 20,
    stagger: {
      each: 0.15,
    },
    scrollTrigger: {
      trigger: cards,
      toggleActions: "play none none reset",
      start: "top 80%",
    },
  });
</script>
