---
import Layout from "../layouts/Layout.astro";
import tick from "../assets/tick.png";
import { Image } from "astro:assets";
---

<Layout title="Submission Success">
  <div
    class="flex items-center justify-center min-h-[calc(100vh_-_72px)] flex-col bg-[#F7F7F7] px-4 sm:px-6 lg:px-8 py-8 text-center"
  >
    <Image
      src={tick}
      alt="Success Tick"
      class="w-16 md:w-20 lg:w-24 h-16 md:h-20 lg:h-24 mb-3 md:mb-4"
    />
    <h1
      class="text-pretty text-lg md:text-xl lg:text-2xl font-semibold text-gray-800 max-w-md"
    >
      Your response has been successfully submitted!
    </h1>
    <p class="text-sm md:text-base text-gray-600 mt-2 md:mt-3 max-w-md">
      Thank you for your feedback. We appreciate your input and will get back to
      you soon.
    </p>
    <a
      href="/"
      class="mt-6 md:mt-8 px-5 md:px-7 py-2 md:py-2.5 rounded-full bg-sky hover:bg-ocean text-white text-sm md:text-base transition-colors"
    >
      Back to Home
    </a>
  </div>
</Layout>
