---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";
---

<Layout title="Products & Services">
  <main class="min-h-screen">
    <div class="flex flex-col justify-center items-center w-full">
      <div
        class="w-full bg-sky/5 pt-36 sm:pt-24 md:pt-28 lg:pt-32 px-4 sm:px-6 md:px-8 lg:px-12 py-8 sm:py-12 md:py-16 lg:py-20 mb-8 sm:mb-12 md:mb-16"
      >
        <div class="max-w-4xl mx-auto text-center">
          <h1
            class="product_fades text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-800 mb-4"
          >
            Products And Services
          </h1>
          <p
            class="product_fades text-base sm:text-lg text-gray-600 max-w-2xl mx-auto"
          >
            Explore our diverse product range, carefully selected to meet the
            highest international standards
          </p>
        </div>
      </div>

      <div
        class="product_fades w-full max-w-7xl px-4 sm:px-6 lg:px-8 pb-12 sm:pb-16 md:pb-20"
      >
        <div
          class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 lg:gap-10"
        >
          <Card />
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);
  const elements = document.querySelectorAll(".product_fades");
  gsap.from(elements, {
    opacity: 0,
    y: 20,
    stagger: {
      each: 0.2,
    },
    scrollTrigger: {
      trigger: elements,
      toggleActions: "play pause resume reset",
      start: "top 80%",
    },
  });
</script>
